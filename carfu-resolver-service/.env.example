# Official YouTube Data API v3 key. Never commit a real value.
# Create a key in Google Cloud Console → APIs & Services → Credentials
# after enabling "YouTube Data API v3".
YOUTUBE_API_KEY=

# HTTP listen port for the standalone resolver.
PORT=8787

# Optional. If true, the provider may call videos.list (1 unit from the
# 10,000/day combined pool) for statistics. Default false to save quota.
YOUTUBE_FETCH_STATS=false
