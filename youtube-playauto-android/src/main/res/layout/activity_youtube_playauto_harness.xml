<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/harness_title"
        android:textColor="#EEEEEE"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/harness_subtitle"
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/harness_query_label"
        android:textColor="#BDBDBD"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/harness_query"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/harness_default_query"
        android:inputType="text"
        android:text="@string/harness_default_query"
        android:textColor="#FFFFFF"
        android:textColorHint="#757575"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/harness_video_id_label"
        android:textColor="#BDBDBD"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/harness_video_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="watch?v=… or 11-char id"
        android:inputType="textNoSuggestions"
        android:textColor="#FFFFFF"
        android:textColorHint="#757575"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/harness_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/harness_mode_dry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/harness_mode_dry"
            android:textColor="#EEEEEE" />

        <RadioButton
            android:id="@+id/harness_mode_device"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/harness_mode_device"
            android:textColor="#EEEEEE" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_detect"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/harness_detect"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_open_app"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/harness_open_app"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/harness_search"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_deep_link"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/harness_deep_link"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_direct_play"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/harness_direct_play"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_playauto"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="2"
            android:text="@string/harness_playauto"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_a11y_settings"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/harness_a11y_settings"
            android:textAllCaps="false" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_export_diagnostic"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="@string/harness_export_diagnostic"
        android:textAllCaps="false" />

    <ScrollView
        android:id="@+id/harness_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/harness_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#C8E6C9"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>
