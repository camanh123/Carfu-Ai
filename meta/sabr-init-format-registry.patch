+public class SabrStreamFirstResponseTest {
+    private static final long LAST_MODIFIED = 1790481582446859L;
+    private static final int ITAG = 140;
+    private static final byte[] AAC_FRAME = new byte[] {0x11, 0x22, 0x33, 0x44};
+
+    @Test
+    public void firstResponseInitThenMediaEmitsInitBeforeSamples() throws Exception {
+        FormatId requested = formatId(ITAG, LAST_MODIFIED);
+        byte[] body = SabrUmpBytes.concat(
+                SabrUmpBytes.part(UMPPartId.FORMAT_INITIALIZATION_METADATA,
+                        formatInit(formatId(ITAG, 0L)).toByteArray()),
+                SabrUmpBytes.part(UMPPartId.MEDIA_HEADER,
+                        mediaHeader(requested, 1, false).toByteArray()),
+                SabrUmpBytes.mediaPart(1, AAC_FRAME),
+                SabrUmpBytes.mediaEndPart(1));
+
+        List<SabrPart> parts = drain(stream(requested), body);
+        assertEquals(FormatInitializedSabrPart.class, parts.get(0).getClass());
+        assertEquals(MediaSegmentInitSabrPart.class, parts.get(1).getClass());
+        assertEquals(MediaSegmentDataSabrPart.class, parts.get(2).getClass());
+        assertEquals(MediaSegmentEndSabrPart.class, parts.get(3).getClass());
+        assertEquals(AAC_FRAME.length, ((MediaSegmentDataSabrPart) parts.get(2)).contentLength);
+    }
+
+    @Test
+    public void firstResponseMediaBeforeInitStillRegistersFormatBeforeSamples() throws Exception {
+        FormatId requested = formatId(ITAG, LAST_MODIFIED);
+        byte[] body = SabrUmpBytes.concat(
+                SabrUmpBytes.part(UMPPartId.MEDIA_HEADER,
+                        mediaHeader(requested, 1, false).toByteArray()),
+                SabrUmpBytes.mediaPart(1, AAC_FRAME),
+                SabrUmpBytes.mediaEndPart(1),
+                SabrUmpBytes.part(UMPPartId.FORMAT_INITIALIZATION_METADATA,
+                        formatInit(formatId(ITAG, 0L)).toByteArray()));
+
+        List<SabrPart> parts = drain(stream(requested), body);
+        assertEquals(FormatInitializedSabrPart.class, parts.get(0).getClass());
+        assertEquals(MediaSegmentInitSabrPart.class, parts.get(1).getClass());
+        assertEquals(MediaSegmentDataSabrPart.class, parts.get(2).getClass());
+        assertEquals(MediaSegmentEndSabrPart.class, parts.get(3).getClass());
+    }
+
+    @Test
+    public void mediaReferencingUnregisteredFormatThrows() throws Exception {
+        FormatId requested = formatId(251, LAST_MODIFIED);
+        FormatId other = formatId(ITAG, LAST_MODIFIED);
+        byte[] body = SabrUmpBytes.concat(
+                SabrUmpBytes.part(UMPPartId.MEDIA_HEADER,
+                        mediaHeader(other, 1, false).toByteArray()),
+                SabrUmpBytes.mediaPart(1, AAC_FRAME),
+                SabrUmpBytes.mediaEndPart(1));
+
+        SabrStream sabrStream = stream(requested);
+        try {
+            drain(sabrStream, body);
+            fail("expected SabrStreamError");
+        } catch (SabrStreamError error) {
+            assertTrue(error.getMessage(), error.getMessage().contains("Initialized format not found"));
+            assertTrue(error.getMessage(), error.getMessage().contains("140"));
+        }
+        assertEquals(0, sabrStream.getSelectedFormatCount());
+    }
+
+    @Test
+    public void sessionResetRequiresFormatInitAgain() throws Exception {
+        FormatId requested = formatId(ITAG, LAST_MODIFIED);
+        byte[] initAndMedia = SabrUmpBytes.concat(
+                SabrUmpBytes.part(UMPPartId.FORMAT_INITIALIZATION_METADATA,
+                        formatInit(requested).toByteArray()),
+                SabrUmpBytes.part(UMPPartId.MEDIA_HEADER,
+                        mediaHeader(requested, 1, false).toByteArray()),
+                SabrUmpBytes.mediaPart(1, AAC_FRAME),
+                SabrUmpBytes.mediaEndPart(1));
+
+        SabrStream sabrStream = stream(requested);
+        assertNotNull(drain(sabrStream, initAndMedia));
+        assertTrue(sabrStream.hasSelectedFormats());
+
+        sabrStream.resetSession();
+        assertEquals(0, sabrStream.getSelectedFormatCount());
+
+        byte[] mediaOnly = SabrUmpBytes.concat(
+                SabrUmpBytes.part(UMPPartId.MEDIA_HEADER,
+                        mediaHeader(formatId(251, LAST_MODIFIED), 2, false).toByteArray()),
+                SabrUmpBytes.mediaPart(2, AAC_FRAME),
+                SabrUmpBytes.mediaEndPart(2));
+        try {
+            drain(sabrStream, mediaOnly);
+            fail("expected SabrStreamError after session reset");
+        } catch (SabrStreamError error) {
+            assertTrue(error.getMessage(), error.getMessage().contains("Initialized format not found"));
+        }
+    }
+
+    private static List<SabrPart> drain(SabrStream sabrStream, byte[] body)
+            throws IOException, InterruptedException {
+        ByteArrayExtractorInput input = SabrUmpBytes.input(body);
+        List<SabrPart> parts = new ArrayList<>();
+        SabrPart part;
+        while ((part = sabrStream.parse(input)) != null) {
+            parts.add(part);
+            if (part instanceof MediaSegmentDataSabrPart) {
+                MediaSegmentDataSabrPart data = (MediaSegmentDataSabrPart) part;
+                data.data.skipFully(data.contentLength);
+            }
+        }
+        return parts;
+    }
+
+    private static SabrStream stream(FormatId requested) {
+        SabrStream sabrStream = new SabrStream(
+                "https://googlevideo.example/videoplayback",
+                "config",
+                ClientInfo.getDefaultInstance(),
+                -1,
+                -1,
+                0,
+                null,
+                false,
+                "video123",
+                60_000);
+        sabrStream.setFormatSelector(new FormatSelector("selected_audio", false, requested));
+        return sabrStream;
+    }
+
+    private static FormatId formatId(int itag, long lastModified) {
+        FormatId.Builder builder = FormatId.newBuilder().setItag(itag);
+        if (lastModified > 0) {
+            builder.setLastModified(lastModified);
+        }
+        return builder.build();
+    }
+
+    private static FormatInitializationMetadata formatInit(FormatId formatId) {
+        return FormatInitializationMetadata.newBuilder()
+                .setFormatId(formatId)
+                .setMimeType("audio/mp4")
+                .setDurationUnits(60_000)
+                .setDurationTimescale(1000)
+                .setEndTimeMs(60_000)
+                .build();
+    }
+
+    private static MediaHeader mediaHeader(FormatId formatId, int headerId, boolean initSeg) {
+        MediaHeader.Builder builder = MediaHeader.newBuilder()
+                .setHeaderId(headerId)
+                .setFormatId(formatId)
+                .setItag(formatId.getItag())
+                .setIsInitSeg(initSeg)
+                .setDurationMs(initSeg ? 0 : 1000)
+                .setStartMs(initSeg ? 0 : 0);
+        if (formatId.hasLastModified()) {
+            builder.setLmt(formatId.getLastModified());
+        }
+        if (!initSeg) {
+            builder.setSequenceNumber(headerId);
+        }
+        return builder.build();
+    }
+}
