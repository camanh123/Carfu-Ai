+package com.google.android.exoplayer2.source.sabr.parser;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import com.google.android.exoplayer2.source.sabr.parser.exceptions.SabrStreamError;
+import com.google.android.exoplayer2.source.sabr.parser.models.FormatSelector;
+import com.google.android.exoplayer2.source.sabr.parser.results.ProcessMediaHeaderResult;
+import com.google.android.exoplayer2.source.sabr.protos.misc.FormatId;
+import com.google.android.exoplayer2.source.sabr.protos.videostreaming.FormatInitializationMetadata;
+import com.google.android.exoplayer2.source.sabr.protos.videostreaming.MediaHeader;
+import com.google.android.exoplayer2.source.sabr.protos.videostreaming.StreamerContext.ClientInfo;
+
+import org.junit.Test;
+
+public class SabrProcessorInitLifecycleTest {
+    private static final long LAST_MODIFIED = 1790481582446859L;
+    private static final int ITAG = 140;
+
+    @Test
+    public void mediaHeaderMatchesInitWhenLastModifiedIsOnlyOnMediaHeader() {
+        SabrProcessor processor = processorWithSelector(formatId(ITAG, LAST_MODIFIED));
+        processor.processFormatInitializationMetadata(formatInit(formatId(ITAG, 0L), false));
+
+        ProcessMediaHeaderResult result = processor.processMediaHeader(
+                mediaHeader(formatId(ITAG, LAST_MODIFIED), /* headerId= */ 1, /* initSeg= */ false));
+
+        assertNotNull(result.sabrPart);
+        assertEquals(ITAG, result.sabrPart.formatId.getItag());
+        assertEquals(1, processor.getSelectedFormatCount());
+    }
+
+    @Test
+    public void firstResponseInitThenMediaRegistersBeforeSamples() {
+        SabrProcessor processor = processorWithSelector(formatId(ITAG, LAST_MODIFIED));
+        processor.processFormatInitializationMetadata(
+                formatInit(formatId(ITAG, LAST_MODIFIED), true));
+        ProcessMediaHeaderResult initSeg = processor.processMediaHeader(
+                mediaHeader(formatId(ITAG, LAST_MODIFIED), 1, true));
+        ProcessMediaHeaderResult mediaSeg = processor.processMediaHeader(
+                mediaHeader(formatId(ITAG, LAST_MODIFIED), 2, false));
+
+        assertNotNull(initSeg.sabrPart);
+        assertTrue(initSeg.sabrPart.isInitSegment);
+        assertNotNull(mediaSeg.sabrPart);
+        assertFalse(mediaSeg.sabrPart.isInitSegment);
+    }
+
+    @Test
+    public void mediaHeaderForUnregisteredFormatThrows() {
+        SabrProcessor processor = processorWithSelector(formatId(251, LAST_MODIFIED));
+        try {
+            processor.processMediaHeader(mediaHeader(formatId(ITAG, LAST_MODIFIED), 1, false));
+            fail("expected SabrStreamError");
+        } catch (SabrStreamError error) {
+            assertTrue(error.getMessage(), error.getMessage().contains("Initialized format not found"));
+            assertTrue(error.getMessage(), error.getMessage().contains("140"));
+        }
+        assertEquals(0, processor.getSelectedFormatCount());
+    }
+
+    @Test
+    public void requestedFormatCanBeProvisionedWhenInitArrivesAfterMedia() {
+        SabrProcessor processor = processorWithSelector(formatId(ITAG, LAST_MODIFIED));
+        ProcessMediaHeaderResult beforeInit = processor.processMediaHeader(
+                mediaHeader(formatId(ITAG, LAST_MODIFIED), 1, false));
+        assertNotNull(beforeInit.sabrPart);
+        assertTrue(processor.hasSelectedFormats());
+
+        processor.processFormatInitializationMetadata(
+                formatInit(formatId(ITAG, LAST_MODIFIED), true));
+        assertEquals(1, processor.getSelectedFormatCount());
+    }
+
+    @Test
+    public void sessionResetClearsRegistrySoNextVideoMustReinitialize() {
+        SabrProcessor processor = processorWithSelector(formatId(ITAG, LAST_MODIFIED));
+        processor.processFormatInitializationMetadata(formatInit(formatId(ITAG, LAST_MODIFIED), true));
+        assertTrue(processor.hasSelectedFormats());
+
+        processor.resetSession();
+        assertFalse(processor.hasSelectedFormats());
+        assertTrue(processor.getInitializedFormats().isEmpty());
+
+        try {
+            processor.processMediaHeader(mediaHeader(formatId(251, LAST_MODIFIED), 1, false));
+            fail("expected SabrStreamError after session reset");
+        } catch (SabrStreamError error) {
+            assertTrue(error.getMessage(), error.getMessage().contains("Initialized format not found"));
+        }
+    }
+
+    @Test
+    public void seekResetDoesNotDropSelectedFormats() {
+        SabrProcessor processor = processorWithSelector(formatId(ITAG, LAST_MODIFIED));
+        processor.processFormatInitializationMetadata(formatInit(formatId(ITAG, LAST_MODIFIED), true));
+        processor.processMediaHeader(mediaHeader(formatId(ITAG, LAST_MODIFIED), 1, false));
+        processor.processMediaEnd(1);
+
+        processor.reset(ITAG);
+        assertTrue(processor.hasSelectedFormats());
+        assertNotNull(processor.processMediaHeader(
+                mediaHeader(formatId(ITAG, LAST_MODIFIED), 2, false)).sabrPart);
+    }
+
+    private static SabrProcessor processorWithSelector(FormatId requested) {
+        SabrProcessor processor = new SabrProcessor(
+                "config",
+                ClientInfo.getDefaultInstance(),
+                -1,
+                -1,
+                0,
+                null,
+                false,
+                "video123",
+                60_000);
+        processor.setFormatSelector(new FormatSelector("selected_audio", false, requested));
+        return processor;
+    }
+
+    private static FormatId formatId(int itag, long lastModified) {
+        FormatId.Builder builder = FormatId.newBuilder().setItag(itag);
+        if (lastModified > 0) {
+            builder.setLastModified(lastModified);
+        }
+        return builder.build();
+    }
+
+    private static FormatInitializationMetadata formatInit(FormatId formatId, boolean withLastModifiedCopy) {
+        return FormatInitializationMetadata.newBuilder()
+                .setFormatId(formatId)
+                .setMimeType("audio/mp4")
+                .setDurationUnits(60_000)
+                .setDurationTimescale(1000)
+                .setEndTimeMs(60_000)
+                .build();
+    }
+
+    private static MediaHeader mediaHeader(FormatId formatId, int headerId, boolean initSeg) {
+        MediaHeader.Builder builder = MediaHeader.newBuilder()
+                .setHeaderId(headerId)
+                .setFormatId(formatId)
+                .setItag(formatId.getItag())
+                .setIsInitSeg(initSeg)
+                .setDurationMs(initSeg ? 0 : 1000)
+                .setStartMs(initSeg ? 0 : 1000);
+        if (formatId.hasLastModified()) {
+            builder.setLmt(formatId.getLastModified());
+        }
+        if (!initSeg) {
+            builder.setSequenceNumber(headerId);
+        }
+        return builder.build();
+    }
+}
