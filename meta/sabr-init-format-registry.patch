+package com.google.android.exoplayer2.source.sabr.parser.models;
+
+import com.google.android.exoplayer2.source.sabr.protos.misc.FormatId;
+
+/**
+ * Stable SABR format keys. Protobuf {@link FormatId#toString()} is not a registry
+ * key: MediaHeader often includes {@code last_modified} while
+ * FormatInitializationMetadata may omit it (or the reverse), so the printed
+ * forms do not match even when they refer to the same itag/xtags tuple.
+ */
+public final class FormatIdKeys {
+    private FormatIdKeys() {}
+
+    /**
+     * Exact identity: itag, last_modified when present, xtags when present.
+     * Unset last_modified is stored as 0 so an omitted field and an explicit 0
+     * compare equal, matching protobuf's proto3 optional default.
+     */
+    public static String canonical(FormatId formatId) {
+        if (formatId == null) {
+            return "";
+        }
+        return formatId.getItag()
+                + "|"
+                + (formatId.hasLastModified() ? formatId.getLastModified() : 0L)
+                + "|"
+                + (formatId.hasXtags() ? formatId.getXtags() : "");
+    }
+
+    /**
+     * YouTube DRC/language variants share an itag and are distinguished by
+     * xtags. last_modified is intentionally excluded.
+     */
+    public static String itagXtags(FormatId formatId) {
+        if (formatId == null) {
+            return "";
+        }
+        return formatId.getItag()
+                + "|"
+                + (formatId.hasXtags() ? formatId.getXtags() : "");
+    }
+
+    public static boolean sameItag(FormatId left, FormatId right) {
+        return left != null && right != null && left.hasItag() && right.hasItag()
+                && left.getItag() == right.getItag();
+    }
+}
