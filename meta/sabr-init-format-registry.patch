+    SelectedFormat findSelectedFormat(FormatId formatId) {
+        if (formatId == null) {
+            return null;
+        }
+
+        SelectedFormat exact = selectedFormats.get(FormatIdKeys.canonical(formatId));
+        if (exact != null) {
+            return exact;
+        }
+
+        String itagXtags = FormatIdKeys.itagXtags(formatId);
+        SelectedFormat xtagsMatch = null;
+        boolean xtagsAmbiguous = false;
+        SelectedFormat itagMatch = null;
+        int itagMatches = 0;
+
+        for (SelectedFormat candidate : selectedFormats.values()) {
+            if (candidate.formatId == null) {
+                continue;
+            }
+            if (FormatIdKeys.itagXtags(candidate.formatId).equals(itagXtags)) {
+                if (xtagsMatch == null) {
+                    xtagsMatch = candidate;
+                } else if (!FormatIdKeys.canonical(xtagsMatch.formatId)
+                        .equals(FormatIdKeys.canonical(candidate.formatId))) {
+                    xtagsAmbiguous = true;
+                }
+            }
+            if (FormatIdKeys.sameItag(candidate.formatId, formatId)) {
+                itagMatches++;
+                itagMatch = candidate;
+            }
+        }
+
+        if (xtagsMatch != null && !xtagsAmbiguous) {
+            return xtagsMatch;
+        }
+        if (itagMatches == 1) {
+            return itagMatch;
+        }
+        return null;
+    }
