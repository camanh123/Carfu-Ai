@@ -0,0 +1,85 @@
+package com.google.android.exoplayer2.source.sabr.parser;
+
+import com.google.android.exoplayer2.source.sabr.parser.misc.ByteArrayExtractorInput;
+import com.google.android.exoplayer2.source.sabr.parser.ump.UMPPartId;
+
+import java.io.ByteArrayOutputStream;
+
+final class SabrUmpBytes {
+    private SabrUmpBytes() {}
+
+    static byte[] concat(byte[]... chunks) {
+        int size = 0;
+        for (byte[] chunk : chunks) {
+            size += chunk.length;
+        }
+        byte[] out = new byte[size];
+        int offset = 0;
+        for (byte[] chunk : chunks) {
+            System.arraycopy(chunk, 0, out, offset, chunk.length);
+            offset += chunk.length;
+        }
+        return out;
+    }
+
+    static byte[] part(int partId, byte[] payload) {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        writeVarInt(out, partId);
+        writeVarInt(out, payload.length);
+        out.write(payload, 0, payload.length);
+        return out.toByteArray();
+    }
+
+    static byte[] mediaPart(long headerId, byte[] media) {
+        ByteArrayOutputStream payload = new ByteArrayOutputStream();
+        writeVarInt(payload, headerId);
+        payload.write(media, 0, media.length);
+        return part(UMPPartId.MEDIA, payload.toByteArray());
+    }
+
+    static byte[] mediaEndPart(long headerId) {
+        ByteArrayOutputStream payload = new ByteArrayOutputStream();
+        writeVarInt(payload, headerId);
+        return part(UMPPartId.MEDIA_END, payload.toByteArray());
+    }
+
+    static ByteArrayExtractorInput input(byte[] umpBody) {
+        return new ByteArrayExtractorInput(umpBody);
+    }
+
+    /**
+     * Matches {@link com.google.android.exoplayer2.source.sabr.parser.ump.UMPDecoder} varint.
+     */
+    static void writeVarInt(ByteArrayOutputStream out, long value) {
+        if (value < 0) {
+            throw new IllegalArgumentException("varint must be unsigned: " + value);
+        }
+        if (value <= 127) {
+            out.write((int) value);
+            return;
+        }
+        if (value <= 16383) {
+            out.write(0x80 | (int) (value & 0x3F));
+            out.write((int) (value >> 6));
+            return;
+        }
+        if (value <= 2097151) {
+            out.write(0xC0 | (int) (value & 0x1F));
+            out.write((int) ((value >> 5) & 0xFF));
+            out.write((int) ((value >> 13) & 0xFF));
+            return;
+        }
+        if (value <= 268435455) {
+            out.write(0xE0 | (int) (value & 0x0F));
+            out.write((int) ((value >> 4) & 0xFF));
+            out.write((int) ((value >> 12) & 0xFF));
+            out.write((int) ((value >> 20) & 0xFF));
+            return;
+        }
+        out.write(0xF0);
+        out.write((int) (value & 0xFF));
+        out.write((int) ((value >> 8) & 0xFF));
+        out.write((int) ((value >> 16) & 0xFF));
+        out.write((int) ((value >> 24) & 0xFF));
+    }
+}
