+package com.google.android.exoplayer2.source.sabr.parser.models;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotEquals;
+
+import com.google.android.exoplayer2.source.sabr.protos.misc.FormatId;
+
+import org.junit.Test;
+
+public class FormatIdKeysTest {
+    private static final long LAST_MODIFIED = 1790481582446859L;
+
+    @Test
+    public void protobufToStringDiffersWhenLastModifiedIsOnlyOnOneSide() {
+        FormatId initId = FormatId.newBuilder().setItag(140).build();
+        FormatId mediaId = FormatId.newBuilder()
+                .setItag(140)
+                .setLastModified(LAST_MODIFIED)
+                .build();
+
+        // This is the device failure mode: selectedFormats was keyed by
+        // FormatId.toString() from FORMAT_INITIALIZATION_METADATA, then
+        // MediaHeader lookup used a toString() that also prints last_modified.
+        assertNotEquals(initId.toString(), mediaId.toString());
+        assertEquals("140|0|", FormatIdKeys.canonical(initId));
+        assertEquals("140|" + LAST_MODIFIED + "|", FormatIdKeys.canonical(mediaId));
+        assertEquals(FormatIdKeys.itagXtags(initId), FormatIdKeys.itagXtags(mediaId));
+        assertEquals("140|", FormatIdKeys.itagXtags(mediaId));
+    }
+
+    @Test
+    public void xtagsDistinguishDrcVariantsWithTheSameItag() {
+        FormatId plain = FormatId.newBuilder().setItag(140).setLastModified(LAST_MODIFIED).build();
+        FormatId drc = FormatId.newBuilder()
+                .setItag(140)
+                .setLastModified(LAST_MODIFIED)
+                .setXtags("drc")
+                .build();
+
+        assertNotEquals(FormatIdKeys.canonical(plain), FormatIdKeys.canonical(drc));
+        assertNotEquals(FormatIdKeys.itagXtags(plain), FormatIdKeys.itagXtags(drc));
+    }
+}
