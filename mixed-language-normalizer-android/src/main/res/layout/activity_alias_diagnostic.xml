<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diagnostic_title"
        android:textColor="#EEEEEE"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/diagnostic_subtitle"
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_listen"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/diagnostic_start"
        android:textAllCaps="false"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_copy"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="@string/diagnostic_copy"
        android:textAllCaps="false" />

    <ScrollView
        android:id="@+id/diagnostic_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_status_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="#EEEEEE"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_partial_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_partial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="#FFE082"
                android:textIsSelectable="true"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_raw_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_raw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_normalized_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_normalized"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="#C8E6C9"
                android:textIsSelectable="true"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_media_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_slot_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_candidate_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_candidate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_canonical_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_canonical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_exact_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_exact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_alias_match_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_alias_match"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_lexical_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_lexical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_phonetic_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_phonetic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_final_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_final"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_confidence_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_confidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_ambiguous_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_ambiguous"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_match_type_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_match_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_rewrite_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_rewrite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_reason_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostic_history_label"
                android:textColor="#80CBC4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/field_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#9E9E9E"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
