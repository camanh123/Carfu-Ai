<resources>

    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="CarfuProbeTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:textColor">#FFEEEEEE</item>
        <item name="colorPrimary">#FF90CAF9</item>
        <item name="colorAccent">#FF90CAF9</item>
        <item name="android:buttonStyle">@style/CarfuProbeButton</item>
    </style>

    <style name="CarfuProbeButton" parent="Widget.AppCompat.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FF121212</item>
    </style>

    <style name="SttPopupTheme">
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
